<% content_for :title, t("titles.app") %>

<%= button_to "", lock_path, method: :post, id: "lock-now", class: "sr-only", tabindex: -1, form: { id: "lock-now-form" } %>
<% if notice %><p class="flash flash-notice" role="status"><%= notice %></p><% end %>
<% if alert %><p class="flash flash-alert" role="alert"><%= alert %></p><% end %>

<div class="home" data-controller="lock offline menu clock edit dialog" data-lock-enabled-value="<%= current_user.auto_lock? %>">
  <%= render "header" %>

  <main class="home-inner">
    <p class="greeting" data-clock-target="greeting"><%= t("js.morning") %></p>
    <time class="when" data-clock-target="clock"></time>

    <form class="omnibox" action="https://duckduckgo.com/" method="get" target="_blank" rel="noopener noreferrer" data-controller="search">
      <input type="search" name="q" data-search-target="query" placeholder="<%= t("js.search_placeholder") %>" autocomplete="off" enterkeyhint="search" aria-label="<%= t("js.search_placeholder") %>">
      <button type="button" class="engine-btn" data-search-target="engine" data-action="search#cycle">DuckDuckGo</button>
    </form>

    <%= render "profiles" %>

    <% if @sites.empty? %>
      <section class="empty">
        <h1><%= t("app.empty_title") %></h1>
        <p><%= t("app.empty_lede") %></p>
        <button type="button" class="btn-primary empty-add" data-action="dialog#openSite" data-heading="<%= t("app.add_site") %>" data-profile-id="<%= @profile.id %>" data-site-id="" data-title="" data-url="" data-hint="" data-icon-url="">
          <%= t("app.add_site") %>
        </button>
      </section>
    <% else %>
      <ul class="tiles" data-controller="sort" data-sort-url-value="<%= reorder_sites_path %>">
        <% @sites.each do |site| %>
          <li class="tile-wrap" draggable="true" data-id="<%= site.id %>" data-action="dragstart->sort#start dragover->sort#over drop->sort#drop dragend->sort#end">
            <a class="tile" href="<%= site.url %>" target="_blank" rel="noopener noreferrer">
              <%= render "mark", record: site, size: "lg" %>
              <span class="tile-copy">
                <strong><%= site.title %></strong>
                <em><%= site.hint.presence || site.host %></em>
              </span>
            </a>
            <div class="tile-actions edit-only">
              <button type="button" class="tile-edit" data-action="dialog#openSite" data-heading="<%= t("app.edit_site") %>" data-profile-id="<%= @profile.id %>" data-site-id="<%= site.id %>" data-title="<%= site.title %>" data-url="<%= site.url %>" data-hint="<%= site.hint %>" data-icon-url="<%= site.icon_url %>" aria-label="<%= t("app.edit_site") %>">
                <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M10.4 3.2 12.8 5.6 6.2 12.2H3.8v-2.4Z" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"/></svg>
              </button>
              <%= button_to site_path(site), method: :delete, class: "tile-edit is-danger", form: { class: "tile-delete-form", data: { turbo_confirm: t("js.delete_site_confirm") } }, aria: { label: t("app.delete") } do %>
                <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3.5 4.3h9M6.2 4.3V3.4h3.6v.9M5.3 6.4v5.2M8 6.4v5.2M10.7 6.4v5.2M4.6 4.3l.55 8.1h5.7l.55-8.1" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg>
              <% end %>
            </div>
          </li>
        <% end %>
        <li class="tile-wrap">
          <button type="button" class="tile tile-add" data-action="dialog#openSite" data-heading="<%= t("app.add_site") %>" data-profile-id="<%= @profile.id %>" data-site-id="" data-title="" data-url="" data-hint="" data-icon-url="">
            <span class="mark mark-lg add-mark">+</span>
            <span class="tile-copy">
              <strong><%= t("app.add_site") %></strong>
            </span>
          </button>
        </li>
      </ul>
    <% end %>
  </main>

  <button type="button" class="fab" data-action="dialog#openSite" data-heading="<%= t("app.add_site") %>" data-profile-id="<%= @profile.id %>" data-site-id="" data-title="" data-url="" data-hint="" data-icon-url="" aria-label="<%= t("app.add_site") %>">
    <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 3v10M3 8h10" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>
  </button>

  <%= render "site_dialog" %>
  <%= render "profile_dialog" %>
</div>
