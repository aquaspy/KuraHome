<nav class="profiles" aria-label="<%= t("app.default_profile") %>">
  <% @profiles.each do |profile| %>
    <%= link_to profile.name, profile_href(profile), class: "profile-tab #{"is-on" if profile.id == @profile.id}" %>
  <% end %>
  <button type="button" class="profile-tab profile-add edit-only" data-action="dialog#openProfile" data-heading="<%= t("app.add_profile") %>" data-profile-id="" data-name="" title="<%= t("app.add_profile") %>" aria-label="<%= t("app.add_profile") %>">+</button>
  <button type="button" class="profile-tab profile-edit edit-only" data-action="dialog#openProfile" data-heading="<%= t("app.edit_profile") %>" data-profile-id="<%= @profile.id %>" data-name="<%= @profile.name %>" data-destroyable="<%= @profile.destroyable? %>" title="<%= t("app.edit_profile") %>" aria-label="<%= t("app.edit_profile") %>">
    <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M10.4 3.2 12.8 5.6 6.2 12.2H3.8v-2.4Z" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"/></svg>
  </button>
</nav>
