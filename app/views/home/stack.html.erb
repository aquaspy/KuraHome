<% content_for :title, t("titles.stack") %>

<%= button_to "", lock_path, method: :post, id: "lock-now", class: "sr-only", tabindex: -1, form: { id: "lock-now-form" } %>
<% if notice %><p class="flash flash-notice" role="status"><%= notice %></p><% end %>
<% if alert %><p class="flash flash-alert" role="alert"><%= alert %></p><% end %>

<div class="home" data-controller="lock offline menu edit dialog" data-lock-enabled-value="<%= current_user.auto_lock? %>">
  <%= render "header" %>

  <main class="home-inner is-stack" data-controller="share" data-share-title-value="<%= t("app.stack_title") %>" data-share-profile-value="<%= @profile.name %>" data-share-footer-value="KuraHome">
    <header class="stack-head">
      <div>
        <h1><%= t("app.stack_title") %></h1>
        <p><%= t("app.stack_lede") %></p>
      </div>
      <% if @stack_items.any? %>
        <button type="button" class="text-btn share-btn" data-action="share#download"><%= t("app.share_stack") %></button>
      <% end %>
    </header>

    <%= render "profiles" %>

    <% if @stack_items.empty? %>
      <section class="empty">
        <h1><%= t("app.stack_empty_title") %></h1>
        <p><%= t("app.stack_empty_lede") %></p>
        <button type="button" class="btn-primary empty-add" data-action="dialog#openStack" data-heading="<%= t("app.add_stack_item") %>" data-profile-id="<%= @profile.id %>" data-item-id="" data-category="" data-choice="" data-origin="" data-note="" data-url="" data-icon-url="">
          <%= t("app.add_stack_item") %>
        </button>
      </section>
    <% else %>
      <script type="application/json" data-share-target="payload"><%= raw json_escape(@stack_items.map { |item| { category: item.category, choice: item.choice, origin: item.origin, note: item.note, letter: item.letter, color: item.color, icon: (item.icon_src.present? ? icon_stack_item_path(item) : nil) } }.to_json) %></script>
      <div class="stack-wrap">
        <table class="stack">
          <thead>
            <tr>
              <th class="stack-icon-col"><span class="sr-only"><%= t("app.icon") %></span></th>
              <th><%= t("app.stack_category") %></th>
              <th><%= t("app.stack_choice") %></th>
              <th><%= t("app.stack_origin") %></th>
              <th><%= t("app.stack_note") %></th>
              <th class="stack-edit-col edit-only"><span class="sr-only"><%= t("js.edit") %></span></th>
            </tr>
          </thead>
          <tbody data-controller="sort" data-sort-url-value="<%= reorder_stack_items_path %>">
            <% @stack_items.each do |item| %>
              <tr draggable="true" data-id="<%= item.id %>" data-action="dragstart->sort#start dragover->sort#over drop->sort#drop dragend->sort#end">
                <td class="stack-icon-col"><%= render "mark", record: item, size: "sm" %></td>
                <td data-label="<%= t("app.stack_category") %>" class="stack-cat"><%= item.category %></td>
                <td data-label="<%= t("app.stack_choice") %>" class="stack-choice">
                  <% if item.linked? %>
                    <%= link_to item.choice, item.url, target: "_blank", rel: "noopener noreferrer" %>
                  <% else %>
                    <%= item.choice %>
                  <% end %>
                </td>
                <td data-label="<%= t("app.stack_origin") %>" class="stack-origin"><%= item.origin %></td>
                <td data-label="<%= t("app.stack_note") %>" class="stack-note"><%= item.note %></td>
                <td class="stack-edit-col edit-only">
                  <div class="row-actions">
                    <button type="button" class="row-edit" data-action="dialog#openStack" data-heading="<%= t("app.edit_stack_item") %>" data-profile-id="<%= @profile.id %>" data-item-id="<%= item.id %>" data-category="<%= item.category %>" data-choice="<%= item.choice %>" data-origin="<%= item.origin %>" data-note="<%= item.note %>" data-url="<%= item.url %>" data-icon-url="<%= item.icon_url %>" aria-label="<%= t("app.edit_stack_item") %>">
                      <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M10.4 3.2 12.8 5.6 6.2 12.2H3.8v-2.4Z" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"/></svg>
                    </button>
                    <%= button_to stack_item_path(item), method: :delete, class: "row-edit is-danger", form: { class: "row-delete-form", data: { turbo_confirm: t("js.delete_stack_confirm") } }, aria: { label: t("app.delete") } do %>
                      <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3.5 4.3h9M6.2 4.3V3.4h3.6v.9M5.3 6.4v5.2M8 6.4v5.2M10.7 6.4v5.2M4.6 4.3l.55 8.1h5.7l.55-8.1" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    <% end %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
        <button type="button" class="stack-add" data-action="dialog#openStack" data-heading="<%= t("app.add_stack_item") %>" data-profile-id="<%= @profile.id %>" data-item-id="" data-category="" data-choice="" data-origin="" data-note="" data-url="" data-icon-url="">
          <%= t("app.add_stack_item") %>
        </button>
      </div>
    <% end %>
  </main>

  <button type="button" class="fab" data-action="dialog#openStack" data-heading="<%= t("app.add_stack_item") %>" data-profile-id="<%= @profile.id %>" data-item-id="" data-category="" data-choice="" data-origin="" data-note="" data-url="" data-icon-url="" aria-label="<%= t("app.add_stack_item") %>">
    <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 3v10M3 8h10" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>
  </button>

  <%= render "stack_dialog" %>
  <%= render "profile_dialog" %>
</div>
